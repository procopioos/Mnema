# --- Postgres (docker-compose) ---
POSTGRES_USER=mnema
POSTGRES_PASSWORD=mnema
POSTGRES_DB=mnema
POSTGRES_PORT=5432

# --- Redis (docker-compose) ---
REDIS_PORT=6379

# --- Backend (app) ---
DATABASE_URL=postgresql+asyncpg://mnema:mnema@localhost:5432/mnema
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
STORAGE_DIR=data
MAX_UPLOAD_SIZE_MB=50

# --- Workspace quotas (defaults; admins can override per workspace) ---
MAX_DOCUMENTS_PER_WORKSPACE=100
MAX_STORAGE_BYTES_PER_WORKSPACE=1073741824

# --- Ingestion ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
ARQ_QUEUE_NAME=mnema

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
AUTH_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Frontend (next.config.ts: where the /api dev proxy rewrites to) ---
# API_PROXY=http://127.0.0.1:8000