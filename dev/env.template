# Bootstrap .env for Mnema — filled in by dev/setup.sh (placeholders swapped
# for random credentials). Tokens between double underscores are substituted.

# --- Compose project (container/volume namespacing) ---
COMPOSE_PROJECT_NAME=__COMPOSE_PROJECT_NAME__

# --- Postgres (docker-compose) ---
POSTGRES_USER=mnema
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=mnema
POSTGRES_PORT=5432

# --- Redis (docker-compose) ---
REDIS_PORT=6379

# --- App service ports (host side) ---
API_PORT=8000
WEB_PORT=3000

# --- Backend (used only when running the API natively outside Docker;
#        the compose file overrides DATABASE_URL/REDIS_URL for containers) ---
DATABASE_URL=postgresql+asyncpg://mnema:__POSTGRES_PASSWORD__@localhost:5432/mnema
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
STORAGE_DIR=data
MAX_UPLOAD_SIZE_MB=50

# --- Workspace quotas (defaults; admins can override per workspace) ---
MAX_DOCUMENTS_PER_WORKSPACE=100
MAX_STORAGE_BYTES_PER_WORKSPACE=1073741824

# --- Ingestion ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
ARQ_QUEUE_NAME=mnema

# --- Security ---
SECRET_KEY=__SECRET_KEY__
AUTH_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30